new file mode 100644
index 0000000..e86acfd
--- /dev/null
+++ b/FEXCore/Source/Interface/IR/Passes/GuestBaseRebasePass.cpp
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: ir|opts
+desc: Rebases 32-bit guest memory accesses onto FEXCore::GuestMemoryBase
+$end_info$
+*/
+
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/PassManager.h"
+#include "Interface/IR/Passes.h"
+
+#include <FEXCore/Core/GuestMemoryBase.h>
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/LogManager.h>
+#include <FEXCore/Utils/Profiler.h>
+
+namespace FEXCore::IR {
+namespace {
+class GuestBaseRebase final : public FEXCore::IR::Pass {
+public:
+  explicit GuestBaseRebase(bool Is64BitMode)
+    : Is64BitMode {Is64BitMode} {}
+  void Run(IREmitter* IREmit) override;
+
+private:
+  bool Is64BitMode;
+};
+
+// Index of the guest address argument, or -1 when the op is not a plain guest
+// memory access. Push/Pop variants are rebased in the JIT backend because their
+// address operand is also the updated stack pointer.
+int GuestAddressArg(IROps Op) {
+  switch (Op) {
+#define ADDR(OP, STRUCT, NAME) \
+  case OP_##OP: return IROp_##STRUCT::NAME##_Index;
+    ADDR(LOADMEM, LoadMem, Addr)
+    ADDR(LOADMEMPAIR, LoadMemPair, Addr)
+    ADDR(STOREMEM, StoreMem, Addr)
+    ADDR(STOREMEMPAIR, StoreMemPair, Addr)
+    ADDR(STOREMEMX87SVEOPTPREDICATE, StoreMemX87SVEOptPredicate, Addr)
+    ADDR(LOADMEMX87SVEOPTPREDICATE, LoadMemX87SVEOptPredicate, Addr)
+    ADDR(LOADMEMTSO, LoadMemTSO, Addr)
+    ADDR(STOREMEMTSO, StoreMemTSO, Addr)
+    ADDR(VLOADVECTORMASKED, VLoadVectorMasked, Addr)
+    ADDR(VSTOREVECTORMASKED, VStoreVectorMasked, Addr)
+    ADDR(VLOADVECTORGATHERMASKED, VLoadVectorGatherMasked, AddrBase)
+    ADDR(VLOADVECTORGATHERMASKEDQPS, VLoadVectorGatherMaskedQPS, AddrBase)
+    ADDR(VLOADVECTORELEMENT, VLoadVectorElement, Addr)
+    ADDR(VSTOREVECTORELEMENT, VStoreVectorElement, Addr)
+    ADDR(VBROADCASTFROMMEM, VBroadcastFromMem, Address)
+    ADDR(CACHELINECLEAR, CacheLineClear, Addr)
+    ADDR(CACHELINECLEAN, CacheLineClean, Addr)
+    ADDR(CACHELINEZERO, CacheLineZero, Addr)
+    ADDR(PREFETCH, Prefetch, Addr)
+    ADDR(VSTORENONTEMPORAL, VStoreNonTemporal, Addr)
+    ADDR(VSTORENONTEMPORALPAIR, VStoreNonTemporalPair, Addr)
+    ADDR(VLOADNONTEMPORAL, VLoadNonTemporal, Addr)
+    ADDR(CAS, CAS, Addr)
+    ADDR(CASPAIR, CASPair, Addr)
+    ADDR(ATOMICSWAP, AtomicSwap, Addr)
+    ADDR(ATOMICFETCHADD, AtomicFetchAdd, Addr)
+    ADDR(ATOMICFETCHSUB, AtomicFetchSub, Addr)
+    ADDR(ATOMICFETCHAND, AtomicFetchAnd, Addr)
+    ADDR(ATOMICFETCHCLR, AtomicFetchCLR, Addr)
+    ADDR(ATOMICFETCHOR, AtomicFetchOr, Addr)
+    ADDR(ATOMICFETCHXOR, AtomicFetchXor, Addr)
+    ADDR(ATOMICFETCHNEG, AtomicFetchNeg, Addr)
+    ADDR(VALIDATECODE, ValidateCode, Address)
+#undef ADDR
+  default: return -1;
+  }
+}
+
+void GuestBaseRebase::Run(IREmitter* IREmit) {
+  FEXCORE_PROFILE_SCOPED("PassManager::GuestBaseRebase");
+
+  if (Is64BitMode || !FEXCore::GuestMemoryBase) {
+    return;
+  }
+
+  auto CurrentIR = IREmit->ViewIR();
+  for (auto [BlockNode, BlockHeader] : CurrentIR.GetBlocks()) {
+    IREmit->SetCurrentCodeBlock(BlockNode);
+    for (auto [CodeNode, IROp] : CurrentIR.GetCode(BlockNode)) {
+      const int Arg = GuestAddressArg(IROp->Op);
+      if (Arg < 0) {
+        continue;
+      }
+
+      // HostAddr = GuestMemoryBase + zext32(GuestAddr)
+      IREmit->SetWriteCursorBefore(CodeNode);
+      Ref GuestAddr = IREmit->UnwrapNode(IROp->Args[Arg]);
+      Ref Zext = IREmit->_Bfe(OpSize::i64Bit, 32, 0, GuestAddr);
+      Ref HostAddr = IREmit->Add(OpSize::i64Bit, Zext, FEXCore::GuestMemoryBase);
+      IREmit->ReplaceNodeArgument(CodeNode, Arg, HostAddr);
+    }
+  }
+}
+} // namespace
+
+fextl::unique_ptr<FEXCore::IR::Pass> CreateGuestBaseRebasePass(bool Is64BitMode) {
+  return fextl::make_unique<GuestBaseRebase>(Is64BitMode);
+}
+} // namespace FEXCore::IR
