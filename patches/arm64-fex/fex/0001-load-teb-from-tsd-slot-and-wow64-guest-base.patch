--- /dev/null
+++ b/Source/Windows/Common/GuestAddress.h
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Core/GuestMemoryBase.h>
+#include <cstdint>
+
+// wine-macos-native: conversions between 32-bit guest addresses (offsets) and
+// host addresses (FEXCore::GuestMemoryBase + offset). No-ops when the base is 0.
+namespace FEX::Windows {
+inline uint64_t GuestToHost(uint64_t Guest) {
+  return FEXCore::GuestMemoryBase && Guest <= UINT32_MAX ? FEXCore::GuestMemoryBase + Guest : Guest;
+}
+inline uint64_t HostToGuest(uint64_t Host) {
+  const auto Base = FEXCore::GuestMemoryBase;
+  return Base && Host >= Base && Host - Base <= UINT32_MAX ? Host - Base : Host;
+}
+} // namespace FEX::Windows
