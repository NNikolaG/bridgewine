@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+
+namespace FEXCore {
+// Host address of 32-bit guest address 0 (wine-macos-native WoW64).
+// macOS arm64 processes cannot map anything below 4GB, so a 32-bit guest's
+// address space lives at GuestMemoryBase .. GuestMemoryBase + 4GB.
+// 0 means guest addresses are host addresses (the upstream behaviour).
+inline uint64_t GuestMemoryBase = 0;
+} // namespace FEXCore
