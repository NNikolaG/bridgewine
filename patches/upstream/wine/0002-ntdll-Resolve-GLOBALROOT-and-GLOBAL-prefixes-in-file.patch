From 5da1c4d2eaf59cd3ccd8f75332807c9448edfea9 Mon Sep 17 00:00:00 2001
From: Nikola Gutic <nikola.gutic@outlook.com>
Date: Sun, 1 Nov 2026 15:22:07 +0000
Subject: [PATCH 2/3] ntdll: Resolve \??\GLOBALROOT and \GLOBAL??\ prefixes in
 file names.

On Windows \??\GLOBALROOT is a symbolic link to the root of the object
namespace and \GLOBAL?? is the global DOS devices directory, so
"\\.\GLOBALROOT\??\C:\dir\file" opens C:\dir\file. Applications build such
names from MemoryMappedFilenameInformation to reopen their own image
(Age of Empires III: Definitive Edition does this at startup).

Signed-off-by: Nikola Gutic <nikola.gutic@outlook.com>
---
 dlls/ntdll/tests/file.c |  8 ++++----
 dlls/ntdll/unix/file.c  | 22 +++++++++++++++++++++-
 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 54c2205..4f8612c 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -5116,11 +5116,11 @@ static void test_globalroot_names(void)
         status = pNtOpenFile( &handle, FILE_READ_ATTRIBUTES | SYNCHRONIZE, &attr, &io,
                               FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                               FILE_SYNCHRONOUS_IO_NONALERT );
-        todo_wine ok( !status, "NtOpenFile returned %#lx\n", status );
+        ok( !status, "NtOpenFile returned %#lx\n", status );
         if (!status) pNtClose( handle );
 
         status = pNtQueryAttributesFile( &attr, &info );
-        todo_wine ok( !status, "NtQueryAttributesFile returned %#lx\n", status );
+        ok( !status, "NtQueryAttributesFile returned %#lx\n", status );
         winetest_pop_context();
     }
 
@@ -5128,8 +5128,8 @@ static void test_globalroot_names(void)
     swprintf( name, ARRAY_SIZE(name), L"\\\\.\\GLOBALROOT\\??\\%s", path );
     handle = CreateFileW( name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
                           OPEN_EXISTING, 0, NULL );
-    todo_wine ok( handle != INVALID_HANDLE_VALUE, "CreateFileW(%s) failed, error %lu\n",
-                  debugstr_w(name), GetLastError() );
+    ok( handle != INVALID_HANDLE_VALUE, "CreateFileW(%s) failed, error %lu\n",
+        debugstr_w(name), GetLastError() );
     if (handle != INVALID_HANDLE_VALUE) CloseHandle( handle );
 
     DeleteFileW( path );
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index f63b6bd..ceffe62 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3038,9 +3038,29 @@ failed:
 
 
 /* return the length of the DOS namespace prefix if any */
-static inline int get_dos_prefix_len( const UNICODE_STRING *name )
+static int get_dos_prefix_len( const UNICODE_STRING *name )
 {
     static const WCHAR dosdev_prefixW[] = {'\\','D','o','s','D','e','v','i','c','e','s','\\'};
+    static const WCHAR global_prefixW[] = {'\\','G','L','O','B','A','L','?','?','\\'};
+    static const WCHAR globalrootW[] = {'\\','?','?','\\','G','L','O','B','A','L','R','O','O','T'};
+
+    /* \??\GLOBALROOT links to the object namespace root, e.g. \\.\GLOBALROOT\??\C:\file */
+    if (name->Length > sizeof(globalrootW) &&
+        !wcsnicmp( name->Buffer, globalrootW, ARRAY_SIZE( globalrootW )) &&
+        name->Buffer[ARRAY_SIZE( globalrootW )] == '\\')
+    {
+        UNICODE_STRING rest;
+        int len;
+
+        rest.Buffer = name->Buffer + ARRAY_SIZE( globalrootW );
+        rest.Length = rest.MaximumLength = name->Length - sizeof(globalrootW);
+        if ((len = get_dos_prefix_len( &rest ))) return ARRAY_SIZE( globalrootW ) + len;
+        return 0;
+    }
+
+    if (name->Length >= sizeof(global_prefixW) &&
+        !wcsnicmp( name->Buffer, global_prefixW, ARRAY_SIZE( global_prefixW )))
+        return ARRAY_SIZE( global_prefixW );
 
     if (name->Length >= sizeof(nt_prefixW) &&
         !memcmp( name->Buffer, nt_prefixW, sizeof(nt_prefixW) ))
-- 
