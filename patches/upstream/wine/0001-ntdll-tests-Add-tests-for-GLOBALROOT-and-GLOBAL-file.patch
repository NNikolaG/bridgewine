From ba9c3adc0b82688ef4b09ee09f1e68fa54bad01c Mon Sep 17 00:00:00 2001
From: Nikola Gutic <nikola.gutic@outlook.com>
Date: Sun, 1 Nov 2026 14:36:40 +0000
Subject: [PATCH 1/3] ntdll/tests: Add tests for \??\GLOBALROOT and \GLOBAL??
 file names.

Signed-off-by: Nikola Gutic <nikola.gutic@outlook.com>
---
 dlls/ntdll/tests/file.c | 51 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 0409614..54c2205 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -5085,6 +5085,56 @@ static void test_NtCreateFile(void)
     RemoveDirectoryW( path );
 }
 
+static void test_globalroot_names(void)
+{
+    static const WCHAR *prefixes[] =
+    {
+        L"\\??\\GLOBALROOT\\??\\",
+        L"\\??\\globalroot\\DosDevices\\",
+        L"\\??\\GLOBALROOT\\GLOBAL??\\",
+        L"\\GLOBAL??\\",
+    };
+    WCHAR path[MAX_PATH], name[MAX_PATH + 32];
+    FILE_BASIC_INFORMATION info;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    UNICODE_STRING nameW;
+    NTSTATUS status;
+    HANDLE handle;
+    unsigned int i;
+
+    GetTempPathW( MAX_PATH, path );
+    GetTempFileNameW( path, L"glr", 0, path );
+
+    for (i = 0; i < ARRAY_SIZE(prefixes); i++)
+    {
+        winetest_push_context( "%s", debugstr_w(prefixes[i]) );
+        swprintf( name, ARRAY_SIZE(name), L"%s%s", prefixes[i], path );
+        pRtlInitUnicodeString( &nameW, name );
+        InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, 0, NULL );
+
+        status = pNtOpenFile( &handle, FILE_READ_ATTRIBUTES | SYNCHRONIZE, &attr, &io,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                              FILE_SYNCHRONOUS_IO_NONALERT );
+        todo_wine ok( !status, "NtOpenFile returned %#lx\n", status );
+        if (!status) pNtClose( handle );
+
+        status = pNtQueryAttributesFile( &attr, &info );
+        todo_wine ok( !status, "NtQueryAttributesFile returned %#lx\n", status );
+        winetest_pop_context();
+    }
+
+    /* what applications usually pass, e.g. built from MemoryMappedFilenameInformation */
+    swprintf( name, ARRAY_SIZE(name), L"\\\\.\\GLOBALROOT\\??\\%s", path );
+    handle = CreateFileW( name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                          OPEN_EXISTING, 0, NULL );
+    todo_wine ok( handle != INVALID_HANDLE_VALUE, "CreateFileW(%s) failed, error %lu\n",
+                  debugstr_w(name), GetLastError() );
+    if (handle != INVALID_HANDLE_VALUE) CloseHandle( handle );
+
+    DeleteFileW( path );
+}
+
 static void test_read_write(void)
 {
     static const char contents[14] = "1234567890abcd";
@@ -7643,4 +7693,5 @@ START_TEST(file)
     test_reparse_points();
     test_file_map_large_size();
     test_find_file();
+    test_globalroot_names();
 }
-- 
