From 4fafa79a73a811011a4db9fb2a3895d5acf87b06 Mon Sep 17 00:00:00 2001
From: Nikola Gutic <nikola.gutic@outlook.com>
Date: Sun, 1 Nov 2026 15:22:07 +0000
Subject: [PATCH 3/3] ntdll: Restore the TEB GSBASE in sigsys_handler() on
 macOS.

init_handler() switches GSBASE to the pthread TSD, but unlike the other
signal handlers sigsys_handler() does not go through leave_handler(), so
it returns into __wine_syscall_dispatcher with GSBASE still pointing at
the pthread TSD. The dispatcher then reads the TEB from %gs:0x30, gets
NULL and faults, and the direct syscall fails with
STATUS_ACCESS_VIOLATION.

Seen with games whose copy protection issues raw syscalls, e.g. Age of
Empires II/III: Definitive Edition (NtAllocateVirtualMemory).

Signed-off-by: Nikola Gutic <nikola.gutic@outlook.com>
---
 dlls/ntdll/unix/signal_x86_64.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 7bff70b..454f8ac 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2608,6 +2608,10 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
         frame->restore_flags |= CONTEXT_CONTROL;
     }
     RIP_sig(sigcontext) = (ULONG64)__wine_syscall_dispatcher_prolog_end_ptr;
+#ifdef __APPLE__
+    /* init_handler() switched GSBASE to the pthread TSD, the dispatcher expects the TEB */
+    if (amd64_thread_data( data )) _thread_set_tsd_base( (uint64_t)data->teb );
+#endif
 }
 #endif
 
