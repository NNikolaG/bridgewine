+#ifdef __APPLE__
+/* x86-64 guest code (and the x64 syscall thunks in ntdll, which sandboxes copy and
+ * run) reads KUSER_SHARED_DATA at its fixed Windows address 0x7ffe0000.  Nothing can
+ * be mapped below 4GB on arm64 macOS, so the emulator's load faults there: perform
+ * the load from the relocated page and skip the instruction.  Stores are not
+ * emulated (the page is read-only on Windows too).  Returns TRUE if emulated. */
+static BOOL emulate_user_shared_data_load( ucontext_t *sigcontext, ULONG_PTR addr )
+{
+    unsigned int instr, rt, rn, rt2, size, opc, count = 1, i;
+    BOOL simd, sign = FALSE, sign32 = FALSE, has_writeback = FALSE;
+    LONG64 writeback = 0;
+    unsigned int regs[2];
+
+    if (addr < 0x7ffe0000 || addr >= 0x7ffe1000) return FALSE;
+
+    instr = *(unsigned int *)PC_sig( sigcontext );
+    rt = instr & 0x1f;
+    rn = (instr >> 5) & 0x1f;
+    rt2 = (instr >> 10) & 0x1f;
+    size = 1u << (instr >> 30);
+    opc = (instr >> 22) & 3;
+    simd = (instr >> 26) & 1;
+
+    if ((instr & 0x3f600000) == 0x08400000)  /* LDXR / LDAXR / LDAR / LDLAR */
+    {
+    }
+    else if ((instr & 0x3fbffc00) == 0x38bfc000)  /* LDAPR */
+    {
+    }
+    else if ((instr & 0x3f200c00) == 0x19000000)  /* LDAPUR / LDAPURS* */
+    {
+        if (!opc) return FALSE;
+        sign = opc >= 2;
+        sign32 = opc == 3;
+    }
+    else if ((instr & 0x3a000000) == 0x38000000)  /* LDR*: unsigned offset, unscaled, pre/post index, register offset */
+    {
+        if (!(instr & 0x01000000))
+        {
+            unsigned int mode = (instr >> 10) & 3;
+            if (instr & 0x00200000)
+            {
+                if (mode != 2) return FALSE;  /* atomics, pointer auth */
+            }
+            else if (mode & 1)
+            {
+                writeback = ((LONG64)(instr >> 12) << 55) >> 55;
+                has_writeback = TRUE;
+            }
+        }
+        if (simd)
+        {
+            if (opc == 3 && size == 1) size = 16;
+            else if (opc != 1) return FALSE;
+        }
+        else
+        {
+            if (!opc) return FALSE;
+            if (opc == 2 && size == 8)  /* PRFM */
+            {
+                PC_sig( sigcontext ) += 4;
+                return TRUE;
+            }
+            sign = opc >= 2;
+            sign32 = opc == 3;
+        }
+    }
+    else if ((instr & 0x3a400000) == 0x28400000)  /* LDP / LDPSW / LDNP */
+    {
+        unsigned int mode = (instr >> 23) & 3, o = instr >> 30;
+        LONG64 imm;
+
+        if (simd)
+        {
+            if (o > 2) return FALSE;
+            size = 4u << o;
+        }
+        else
+        {
+            if (o == 3) return FALSE;
+            size = (o & 2) ? 8 : 4;
+            sign = o == 1;
+        }
+        imm = (((LONG64)(instr >> 15) << 57) >> 57) * size;
+        if (rn == 31) return FALSE;
+        addr = REGn_sig( rn, sigcontext ) + (mode == 1 ? 0 : imm);
+        if (addr < 0x7ffe0000 || addr >= 0x7ffe1000) return FALSE;
+        if (mode & 1)
+        {
+            writeback = imm;
+            has_writeback = TRUE;
+        }
+        count = 2;
+    }
+    else return FALSE;
+
+    if (has_writeback && (rn == 31 || rn == rt)) return FALSE;
+    if ((addr & 0xfff) + count * size > 0x1000) return FALSE;
+    regs[0] = rt;
+    regs[1] = rt2;
+    for (i = 0; i < count; i++)
+    {
+        const char *src = (const char *)user_shared_data + (addr & 0xfff) + i * size;
+
+        if (simd)
+        {
+            __uint128_t val = 0;
+            memcpy( &val, src, size );
+            sigcontext->uc_mcontext->__ns.__v[regs[i]] = val;
+        }
+        else
+        {
+            UINT64 val = 0;
+            memcpy( &val, src, size );
+            if (sign && size < 8)
+            {
+                unsigned int shift = 64 - 8 * size;
+                val = (UINT64)((LONG64)(val << shift) >> shift);
+                if (sign32) val = (UINT32)val;
+            }
+            if (regs[i] != 31) REGn_sig( regs[i], sigcontext ) = val;
+        }
+    }
+    if (has_writeback) REGn_sig( rn, sigcontext ) += writeback;
+    PC_sig( sigcontext ) += 4;
+    return TRUE;
+}
+#endif
+
