+    __asm__( "mrs %0, tpidrro_el0\n\t"
+             "and %0, %0, #0xfffffffffffffff8\n\t"
+             "ldr %0, [%0, #(8 * " __WINE_TEB_TSD_STR(WINE_MACOS_TEB_TSD_KEY) ")]"
+             : "=r" (teb) );
+    return teb;
