+#if defined(__APPLE__) && defined(__aarch64__)
+/* wine-macos-native: macOS arm64 cannot map anything below 4GB, so the 32-bit
+ * address space of WoW64 processes lives in a 4GB window at WOW64_GUEST_BASE.
+ * The base is 4GB aligned, so truncating a host pointer in the window to 32 bits
+ * yields the guest address. Must match FEXCore::GuestMemoryBase. */
+#define WOW64_GUEST_BASE ((ULONG_PTR)0x10000000000)
+#define WOW64_GUEST_SIZE ((ULONG_PTR)0x100000000)
+static BOOL wow64_window_reserved;
+
+static inline BOOL wow64_window_active(void)
+{
+    return wow64_window_reserved && is_wow64();
+}
+
+/* move a sub-4GB address or limit of a WoW64 process into the window */
+static inline void wow64_window_adjust( void **base, ULONG_PTR *limit_low, ULONG_PTR *limit_high )
+{
+    if (!wow64_window_reserved) return;
+    /* nothing below 4GB can be mapped on macOS, so fixed low addresses always go to the window
+     * (the main exe is mapped before the process is flagged as WoW64) */
+    if (*base && (ULONG_PTR)*base < WOW64_GUEST_SIZE) *base = (char *)*base + WOW64_GUEST_BASE;
+    if (!is_wow64()) return;
+    if (*limit_high && *limit_high < WOW64_GUEST_SIZE)
+    {
+        *limit_low = WOW64_GUEST_BASE + max( *limit_low, 0x10000 );
+        *limit_high += WOW64_GUEST_BASE;
+    }
+}
+#else
+static inline BOOL wow64_window_active(void) { return FALSE; }
+static inline void wow64_window_adjust( void **base, ULONG_PTR *limit_low, ULONG_PTR *limit_high ) { }
